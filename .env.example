FLASK_DEBUG=True
FLASK_SQLALCHEMY_DATABASE_URI='postgresql://user:passwd@YOUR_IP:YOUR_PORT/logdb'
FLASK_SQLALCHEMY_ECHO=True
# Required, >= 32 random chars each (the app refuses to start otherwise). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_APP_SECRET_KEY=""
FLASK_JWT_SECRET_KEY=""

DB_PARAMS = { "dbname": "db", "user": "user", "password": "pass", "host": "YOUR_IP", "port": "5432" }
ROUTER_IP="10.0.0.1"
ADGUARD_HOSTPORT="10.0.0.1:8080"
ADGUARD_USERNAME="admin"
ADGUARD_PASSWORD="your_adguard_password"
ADGUARD_RULE_PATH="adguard_home_rule_path"
TELEGRAM_BOT = "your_telegram_bot_token"
TELEGRAM_CHAT_ID = "your_telegram_chat_id"
LONGTITUDE_LATITUDE="location longtitude,latitude"
DISCORD_WEBHOOK_URL="discord_webhook_url"
HAMMERSPOON_ALERT_URL="http://localhost:9181/alert"
MAIL_ACCOUNT="email account"
MAIL_PASSWORD='email app engine password'
MAIL_PERSON_LIST='["receiver email list"]'
ADMIN_IDENTITY="admin_id"

# Monitoring stack (docs/monitoring.md)
GRAFANA_ADMIN_PASSWORD=""   # this exact name (not GF_SECURITY_ADMIN_PASSWORD)
# PROMETHEUS_RETENTION_SIZE="5GB"   # lower it if preflight warns about disk space
# ALERT_EMAIL_TO="you@example.com"   # default: MAIL_ACCOUNT
# GRAFANA_BIND="127.0.0.1"
# DOCKER_ROOT_DIR="/var/snap/docker/common/var-lib-docker"   # snap Docker
# CONTAINERD_SOCKET="/run/containerd/containerd.sock"   # scripts/monitoring/preflight.sh prints the right value
# COMPOSE_FILE=docker-compose.yml:deploy/monitoring/docker-compose.monitoring.yml
# Snap Docker (preflight --deep says containers see a different /): node-exporter on the host:
# COMPOSE_FILE=docker-compose.yml:deploy/monitoring/docker-compose.monitoring.yml:deploy/monitoring/docker-compose.host-node-exporter.yml
# Status picture for the P4 display (deploy/monitoring/docker-compose.display-export.yml):
# COMPOSE_PROFILES=display-export     # exporter as a container (else the host timer)
# DISPLAY_EXPORT_DIR="/home/you/code/esphome-config/grafana-export"
# DISPLAY_TZ="America/Toronto"
# DISPLAY_EXPORT_UID=1000            # uid=/gid= of the share in /etc/fstab
# DISPLAY_EXPORT_GID=1000
# DISPLAY_INTERVAL=300               # seconds; the display marks pictures STALE after 10 min
# DISPLAY_EXPORT_REQUIRE_FSTYPE=cifs # "" to allow a plain local folder
