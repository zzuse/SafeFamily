# Encrypted weekly database backup. Install (edit the path first if your
# checkout is not /srv/SafeFamily):
#   sudo cp deploy/systemd/safefamily-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now safefamily-backup.timer
[Unit]
Description=SafeFamily encrypted database backup
Wants=docker.service snap.docker.dockerd.service
After=docker.service snap.docker.dockerd.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/safefamily/backup.env
ExecStart=/srv/SafeFamily/scripts/db_backup.sh
Nice=10
IOSchedulingClass=idle
