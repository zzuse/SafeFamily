# Copy to /etc/safefamily/backup.env (root-owned, mode 600). Read by
# deploy/systemd/safefamily-backup.service and safefamily-dirsize.service.
BACKUP_DIR=/var/backups/safefamily
BACKUP_AGE_RECIPIENTS=/etc/safefamily/backup-recipients.txt
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile
SAFEFAMILY_DIR=/srv/SafeFamily
# Snap-installed Docker:
# DOCKER_ROOT_DIR=/var/snap/docker/common/var-lib-docker
