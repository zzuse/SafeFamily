# Copy to /etc/safefamily/backup.env (root-owned, mode 600). Read by
# deploy/systemd/safefamily-backup.service and safefamily-dirsize.service.
BACKUP_DIR=/var/backups/safefamily
BACKUP_AGE_RECIPIENTS=/etc/safefamily/backup-recipients.txt
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
# Let this group read the backups (they are encrypted), so you can scp/rsync
# them without sudo. Usually your login group: run `id -gn` to see it.
# BACKUP_GROUP=youruser
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile
# Optional: the repo checkout (the folder with docker-compose.yml), measured
# for Grafana's "Directory sizes" panel. Leave unset: dir_sizes.sh finds it
# from its own location.
# SAFEFAMILY_DIR=/home/you/SafeFamily
# Snap-installed Docker:
# DOCKER_ROOT_DIR=/var/snap/docker/common/var-lib-docker
# Network shares to watch (space separated mount points). Checked every 15
# minutes by dir_sizes.sh; this also keeps a systemd automount mounted, so
# Grafana and the share alerts can see it after a reboot.
# WATCH_MOUNTS=/mnt/nas
