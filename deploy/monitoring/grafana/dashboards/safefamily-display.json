        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
