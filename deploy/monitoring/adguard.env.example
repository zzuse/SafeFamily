# Copy to /etc/safefamily/adguard.env and make it root-only:
#   sudo install -m 600 deploy/monitoring/adguard.env.example /etc/safefamily/adguard.env
# Same values as ADGUARD_HOSTPORT / ADGUARD_USERNAME / ADGUARD_PASSWORD in the app's .env.
ADGUARD_HOSTPORT=10.0.0.1:8080
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=change-me
# Blocked-service ids to report (the list SafeFamily switches; fast, local).
ADGUARD_WATCH_SERVICES="youtube"
# Domains to check with AdGuard's check_host (also covers filter rules), space
# separated. Slow on some routers; set to "" to turn it off.
ADGUARD_WATCH_DOMAINS="youtube.com"
# Seconds per AdGuard API call.
ADGUARD_TIMEOUT=30
# Keep in step with NODE_EXPORTER_TEXTFILE_DIR in /etc/safefamily/backup.env.
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile
